# Kopiere diese Datei zu .env.local (lokal) bzw. trage die Werte in der
# Verwaltung deines Hosters ein. .env.local gehört NICHT ins Repository.

# --- Adresse der Seite -------------------------------------------------
# Die Live-Domain steht fest im Code; diese Zeile braucht es nur, wenn die
# Seite einmal woanders laufen soll (Testumgebung, Vorschau).
# NEXT_PUBLIC_SITE_URL=https://vorschau.vectronia-one.de

# --- Kontaktformular ---------------------------------------------------
# Das Formular verschickt über dein eigenes Postfach. Es geht nichts an
# einen Dritten, es wird nichts gespeichert.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=kunst@vectronia-one.de
SMTP_PASSWORD=
# Wohin Anfragen sollen, falls das ein anderes Postfach ist als SMTP_USER.
CONTACT_TO=kunst@vectronia-one.de
