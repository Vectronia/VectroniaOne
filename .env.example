# Kopiere diese Datei zu .env.local (lokal) bzw. trage die Werte in der
# Verwaltung deines Hosters ein. .env.local gehört NICHT ins Repository.

# --- Adresse der Seite -------------------------------------------------
# Ohne diese Angabe zeigt kein geteilter Link ein Vorschaubild: die Seite
# wird vorgerendert und kennt ihren eigenen Hostnamen sonst nicht.
NEXT_PUBLIC_SITE_URL=https://deine-domain.de

# --- Kontaktformular ---------------------------------------------------
# Das Formular verschickt über dein eigenes Postfach. Es geht nichts an
# einen Dritten, es wird nichts gespeichert.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=post@deine-domain.de
SMTP_PASSWORD=
# Wohin Anfragen sollen, falls das ein anderes Postfach ist als SMTP_USER.
CONTACT_TO=post@deine-domain.de
